# ============================================================
# 模板文件：请复制为 .env 后再填真实值
#   cp .env.example .env
#
# ⚠️ 不要把真实密钥写回本文件！
# .env.example 是要提交到仓库的，真实密钥只应存在于 .env（已被 .gitignore 忽略）。
#
# 注意：VITE_ 前缀的变量会被打包进前端产物，浏览器里可直接看到。
# 因此这里只放「域名白名单 / 配额限制」类的地图 Web Key，
# 绝不要放服务端密钥（如 LLM_API_KEY）。
# ============================================================

# 后端API地址
VITE_API_BASE_URL=http://localhost:8000

# 高德地图Web API Key
VITE_AMAP_WEB_KEY=your_amap_web_api_key_here
# 高德地图Web端JS API Key
VITE_AMAP_WEB_JS_KEY=your_amap_web_js_key_here
