# ============================================================
# 模板文件：请复制为 .env 后再填真实值
#   cp .env.example .env
#
# ⚠️ 不要把真实密钥写回本文件！
# .env.example 是要提交到仓库的，真实密钥只应存在于 .env（已被 .gitignore 忽略）。
# ============================================================

# LLM配置（兼容 OpenAI 协议的服务；不填则沿用框架内置默认值）
# 模型名称
LLM_MODEL_ID=deepseek-chat

# API密钥
LLM_API_KEY=your-api-key-here

# 服务地址
LLM_BASE_URL=https://api.deepseek.com

# 超时时间（可选，默认60秒）
LLM_TIMEOUT=60

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志级别
LOG_LEVEL=INFO

# Unsplash API Credentials
UNSPLASH_ACCESS_KEY=""
UNSPLASH_SECRET_KEY=""

# 高德地图API配置
AMAP_API_KEY=your_amap_api_key_here

# ============================================================
# 访问控制（本地开发保持 off 即可，对外部署必须改）
# ============================================================
# off     = 全部放行（本地开发默认）
# api_key = 校验 X-API-Key 或 Authorization: Bearer
# openid  = 取微信云托管注入的 X-WX-OPENID 作为身份（小程序部署场景）
AUTH_MODE=off

# AUTH_MODE=api_key 时必填，逗号分隔（轮换期可同时保留新旧两个）
API_KEYS=

# AUTH_MODE=openid 时建议填：云托管网关注入的 X-WX-OPENID 在服务可被公网直连时
# 是可伪造的，配了这个就必须额外携带 X-Gateway-Secret 才放行。留空则不校验该头。
GATEWAY_SECRET=

# 限流：按身份维度、每分钟请求数（0 或负数表示不限流）
RATE_LIMIT_PER_MINUTE=30
# 「生成行程」是昂贵端点（4 个 Agent + LLM + 高德配额），单独收紧
RATE_LIMIT_PLAN_PER_MINUTE=6

# 对外部署建议 false：关闭 /docs 与 /redoc，减少接口结构暴露
ENABLE_DOCS=true
